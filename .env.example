# Copy to .env and adjust. Everything has a working default for LOCAL use
# (local = SQLite file, no auth gate). The deployed app on Vercel sets these
# as project env vars instead.

# --- local ---
# DATABASE_PATH=data/recall.db
# ANTHROPIC_API_KEY=sk-ant-...   # enables AI parsing of free-form summaries
# PARSE_MODEL=claude-haiku-4-5-20251001
# RECALL_USER_ID=shreet
# APP_TIMEZONE=America/Los_Angeles  # day boundary for streaks/"due today".
#                                   # Set THIS, not TZ — src/db/index.ts
#                                   # overwrites TZ at startup because the
#                                   # deploy platform presets it to UTC.
# APP_URL=http://localhost:3000     # base URL the MCP tool replies link to;
#                                   # falls back to VERCEL_URL, then localhost

# --- deployed (Vercel) ---
# TURSO_DATABASE_URL=libsql://recall-<org>.turso.io   # switches the app to Turso
# TURSO_AUTH_TOKEN=...
# APP_PASSWORD=...        # activates the login gate (pages + APIs).
#                         # NOTE: setting this also REVOKES the "dev" fallback
#                         # for the two tokens below — they are exempt from the
#                         # gate, so they must be set explicitly or the ICS
#                         # feed and MCP endpoint stop answering.
# CALENDAR_TOKEN=...      # secret in the ICS feed URL
# MCP_TOKEN=...           # bearer token for the MCP endpoint
